# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_64_char_random_hex_string_here
ALLOWED_ORIGINS=http://localhost:3000,https://portail.ars.tn

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ars_user:ars_pass@localhost:5432/ars_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=1800
REDIS_CACHE_TTL_SECONDS=300

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_another_64_char_random_hex
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_PRIMARY=claude
LLM_FALLBACK=openai
LLM_MODEL_CLAUDE=claude-sonnet-4-6
LLM_MODEL_OPENAI=gpt-4o
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE_RESPONSE=0.3
LLM_TEMPERATURE_SUMMARY=0.2

# ── ElevenLabs TTS ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=el_...
ELEVENLABS_VOICE_ID=ARS_VOICE_ID_HERE

# ── STT ──────────────────────────────────────────────────────────────────────
WHISPER_MODEL_PATH=/models/whisper-ars-finetuned
GOOGLE_STT_CREDENTIALS_PATH=/secrets/google-stt.json
STT_PRIMARY=whisper
STT_FALLBACK=google

# ── DigiHealth ───────────────────────────────────────────────────────────────
DIGIHEALTH_BASE_URL=https://api.digihealth.ars.tn/v1
DIGIHEALTH_CLIENT_ID=CHANGE_ME
DIGIHEALTH_CLIENT_SECRET=CHANGE_ME
DIGIHEALTH_TIMEOUT_SECONDS=8
DIGIHEALTH_CIRCUIT_BREAKER_THRESHOLD=3

# ── CRM / Ticketing ──────────────────────────────────────────────────────────
CRM_BASE_URL=https://crm.ars.tn/api
CRM_API_KEY=CHANGE_ME
CRM_TIMEOUT_SECONDS=5

# ── SMS Gateway ──────────────────────────────────────────────────────────────
SMS_GATEWAY_URL=https://sms.ars.tn/api/send
SMS_GATEWAY_API_KEY=CHANGE_ME
SMS_OTP_EXPIRE_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=3

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.ars.tn
SMTP_PORT=587
SMTP_USER=agent-ia@ars.tn
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Agent IA ARS <agent-ia@ars.tn>
SMTP_TLS=true

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
OTEL_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_MAX_ATTEMPTS=3
TOTP_ISSUER=ARS Tunisie