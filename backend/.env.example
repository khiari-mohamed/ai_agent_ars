# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_64_char_random_hex_string_here
ALLOWED_ORIGINS=["http://localhost:3000","https://portail.ars.tn"]

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_generate_a_new_local_password
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_generate_a_new_local_password@localhost:5433/ars_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=1800
REDIS_CACHE_TTL_SECONDS=300

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_another_64_char_random_hex
JWT_ALGORITHM=HS256

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY=claude
LLM_FALLBACK=openai
LLM_MODEL_CLAUDE=claude-sonnet-5-5
LLM_MODEL_CLAUDE_FAST=claude-haiku-5-5
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_OPENAI_FAST=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE_RESPONSE=0.3
LLM_TEMPERATURE_SUMMARY=0.2

# ── ElevenLabs TTS ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4_turbo
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_STABILITY=0.5
TTS_SIMILARITY_BOOST=0.8
TTS_STYLE=0.0
TTS_USE_SPEAKER_BOOST=true
TTS_TIMEOUT_SECONDS=20
TTS_MAX_CHARS=1200
TTS_CACHE_TTL_SECONDS=604800

# ── Voice WebSocket ──────────────────────────────────────────────────────────
VOICE_MAX_UTTERANCE_BYTES=3000000
VOICE_IDLE_TIMEOUT_SECONDS=120
VOICE_MAX_TURNS_PER_MINUTE=12
VOICE_TTS_CONCURRENCY=3

# ── STT (faster-whisper, converted CTranslate2 model) ─────────────────────────
WHISPER_MODEL_PATH=/models/whisper-ars-ct2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
STT_VAD_FILTER=true
STT_PRELOAD=true
STT_MAX_AUDIO_SECONDS=60
STT_MAX_UPLOAD_BYTES=10000000

# ── DigiHealth ───────────────────────────────────────────────────────────────
DIGIHEALTH_BASE_URL=https://api.digihealth.ars.tn/v1
DIGIHEALTH_CLIENT_ID=CHANGE_ME
DIGIHEALTH_CLIENT_SECRET=CHANGE_ME
DIGIHEALTH_TIMEOUT_SECONDS=8
DIGIHEALTH_CIRCUIT_BREAKER_THRESHOLD=3

# ── CRM / Ticketing ──────────────────────────────────────────────────────────
CRM_BASE_URL=https://crm.ars.tn/api
CRM_API_KEY=CHANGE_ME
CRM_TIMEOUT_SECONDS=5

# ── SMS Gateway ──────────────────────────────────────────────────────────────
SMS_GATEWAY_URL=https://sms.ars.tn/api/send
SMS_GATEWAY_API_KEY=CHANGE_ME
SMS_OTP_EXPIRE_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=3

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.ars.tn
SMTP_PORT=587
SMTP_USER=agent-ia@ars.tn
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Agent IA ARS <agent-ia@ars.tn>
SMTP_TLS=true

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
OTEL_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_PRELOAD=true
EMBEDDING_CACHE_DIR=
RAG_TOP_K=5
RAG_CANDIDATES=40
RAG_DENSE_WEIGHT=0.7
RAG_LEXICAL_WEIGHT=0.3
RAG_MIN_SCORE=0.40
RAG_TRIGRAM_THRESHOLD=0.15
RAG_HNSW_EF_SEARCH=200

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_MAX_ATTEMPTS=3
TOTP_ISSUER=ARS Tunisie